# ==============================================================================
# SmartStock Local Development Infrastructure Environment Variables
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# MySQL Database Configuration
# Port 3307 is used on the host to avoid collisions with any existing local MySQL on 3306
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=smartstock
MYSQL_USER=smartstock_user
MYSQL_PASSWORD=smartstock_pass

# Apache Kafka Configuration
KAFKA_PORT=9092

# Kafka Web UI Configuration (accessible at http://localhost:8085)
KAFKA_UI_PORT=8085
