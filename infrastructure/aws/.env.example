# ==============================================================================
# SmartStock AWS Production Environment Variables Template
#
# CRITICAL SECURITY INSTRUCTIONS:
# 1. Copy this file to .env on your EC2 instance:
#      cp .env.example .env
# 2. Replace all placeholder values below with strong, cryptographically generated secrets.
# 3. NEVER commit the resulting .env file to Git or share it across untrusted channels.
# 4. Restrict file permissions on the EC2 host:
#      chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL 8.0 Database Credentials
# Generate strong passwords using: openssl rand -hex 16
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=replace_with_strong_random_root_password_min_24_chars
DB_NAME=smartstock
DB_USERNAME=smartstock_user
DB_PASSWORD=replace_with_strong_random_app_password_min_24_chars

# ------------------------------------------------------------------------------
# 2. Spring Boot Security & JWT Configuration
# MUST be a 256-bit+ (32-byte) cryptographically secure key.
# Generate via: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_openssl_rand_base64_32_secret_key_minimum_256_bits
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. CORS Configuration
# Comma-separated list of allowed origins (your production domain or EC2 public IP)
# Example: https://smartstock.example.com,http://54.123.45.67
# Set to * if using same-origin Nginx proxying exclusively
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 4. Initial Administrative User Seeding
# To bootstrap your first administrator on initial deployment:
#   Set ADMIN_SEED_ENABLED=true and provide secure credentials.
#   After the first boot successfully registers the administrator, set ADMIN_SEED_ENABLED=false
#   and restart the backend (docker compose restart backend).
# ------------------------------------------------------------------------------
ADMIN_SEED_ENABLED=false
ADMIN_NAME=Production Administrator
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace_with_strong_admin_initial_password

# ------------------------------------------------------------------------------
# 5. Kafka Consumer Group
# ------------------------------------------------------------------------------
KAFKA_CONSUMER_GROUP=smartstock-prod-group
