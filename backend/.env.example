# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartstock
DB_USERNAME=smartstock_user
DB_PASSWORD=smartstock_pass
JPA_DDL_AUTO=validate
SHOW_SQL=true

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=smartstock-group

# Security / JWT Configuration
# 256-bit+ (32-byte) secure random secret key in Base64 or Hex format (DO NOT COMMIT ACTUAL SECRETS)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_EXPIRATION_MS=86400000

# Development-only Admin Account Seeder (disabled by default)
ADMIN_SEED_ENABLED=false
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@smartstock.local
ADMIN_PASSWORD=change_me_dev_admin_password

# Development-only Sample Data Seeder (disabled by default)
DEV_DATA_SEED_ENABLED=false
